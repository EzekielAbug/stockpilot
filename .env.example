# application
APP_NAME=StockPilot
APP_ENV=development
DEBUG=true
SECRET_KEY=

# db
DATABASE_URL=postgresql+asyncpg://stockpilot:stockpilot_pass@localhost:5432/stockpilot_db

# redis
REDIS_URL=redis://localhost:6379/0

# jwt auth
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# email (smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=1025
SMTP_USERNAME=your_username
SMTP_PASSWORD=your_password
EMAILS_FROM_EMAIL=noreply@stockpilot.dev
EMAILS_FROM_NAME=StockPilot

# file uploads (S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=stockpilot-uploads

# celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2